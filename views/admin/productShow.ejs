<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Products</title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </head>
  <body>
    <!-- Navigation Header -->
    <header class="bg-blue-500 text-white">
      <div
        class="container mx-auto flex justify-between items-center py-4 px-6"
      >
        <nav>
          <ul class="flex space-x-4">
            <li>
              <a href="/dashboard" class="hover:text-gray-400">Dashboard</a>
            </li>
            <li>
              <a href="/showProduct" class="hover:text-gray-400">Product</a>
            </li>
            <li>
              <a href="/showCategory" class="hover:text-gray-400">Category</a>
            </li>
            <li><a href="/admin/user" class="hover:text-gray-400">Users</a></li>
            <li>
              <a href=""><i class="fa-solid fa-cart-shopping"></i>Orders</a>
            </li>
          </ul>
        </nav>
        <a
          href="/product"
          class="bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded"
          >Add Product</a
        >
      </div>
    </header>

    <div class="container mx-auto mt-10">
      <div class="overflow-x-auto">
        <table class="min-w-full bg-white border border-gray-200">
          <thead>
            <tr>
              <th class="py-2 px-4 border-b">Title</th>
              <th class="py-2 px-4 border-b">Description</th>
              <th class="py-2 px-4 border-b">Category</th>
              <th class="py-2 px-4 border-b">Subcategory</th>
              <th class="py-2 px-4 border-b">Price</th>
              <th class="py-2 px-4 border-b">Offer Price</th>
              <th class="py-2 px-4 border-b">Stock Quantity</th>
              <th class="py-2 px-4 border-b">Colors</th>
              <th class="py-2 px-4 border-b">Sizes</th>
              <th class="py-2 px-4 border-b">Main Image</th>
              <th class="py-2 px-4 border-b">Images</th>
              <th class="py-2 px-4 border-b">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(product => { %>
            <tr id="product-<%= product._id %>">
              <td class="py-2 px-4 border-b"><%= product.name %></td>
              <td class="py-2 px-4 border-b max-w-xs truncate">
                <%= product.description %>
              </td>
              <td class="py-2 px-4 border-b">
                <% if (product.categoryArr[0]) { %> <%=
                product.categoryArr[0].category %> <% } else { %> No Category <%
                } %>
              </td>
              <td class="py-2 px-4 border-b">
                <% if (product.subCategoryArr[0]) { %> <%=
                product.subCategoryArr[0].subCategory %> <% } else { %> No
                Subcategory <% } %>
              </td>

              <td class="py-2 px-4 border-b"><%= product.price %></td>
              <td class="py-2 px-4 border-b"><%= product.offerPrice %></td>
              <td class="py-2 px-4 border-b"><%= product.stock_quantity %></td>
              <td class="py-2 px-4 border-b">
                <%= product.colors.join(', ') %>
              </td>
              <td class="py-2 px-4 border-b">
                <%= product.sizes.join(', ') %>
              </td>
              <td class="py-2 px-4 border-b">
                <a href="/imageShow/<%= product.mainImage %>"
                  ><img
                    src="./product/<%= product.mainImage %>"
                    alt="Main Image"
                    class="w-16 h-16 object-cover"
                /></a>
              </td>
              <td class="py-1 px-0 border-b">
                <ul class="grid grid-cols-2 gap-2">
                  <% product.images.forEach(image => { %>
                  <li>
                    <a href="/imageShow/<%= image %>"
                      ><img
                        src="./product/<%= image %>"
                        alt="Additional Image"
                        class="w-16 h-16 object-cover"
                    /></a>
                  </li>
                  <% }) %>
                </ul>
              </td>
              <td class="py-2 px-4 border-b">
                <a
                  href="/updateProduct/<%= product._id %>"
                  class="text-blue-500 hover:underline mr-2"
                  >Update</a
                >
                <button
                  onclick="deleteProduct('<%= product._id %>')"
                  class="text-red-500 hover:underline"
                >
                  Delete
                </button>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <script>
      function deleteProduct(productId) {
        Swal.fire({
          title: "Are you sure?",
          text: "You won't be able to revert this!",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#3085d6",
          cancelButtonColor: "#d33",
          confirmButtonText: "Yes, delete it!",
        }).then((result) => {
          if (result.isConfirmed) {
            fetch(`/products/delete/${productId}`, {
              method: "DELETE",
            })
              .then((response) => response.json())
              .then((data) => {
                if (data.success) {
                  document.getElementById(`product-${productId}`).remove();
                  Swal.fire(
                    "Deleted!",
                    "Your product has been deleted.",
                    "success"
                  );
                } else {
                  Swal.fire(
                    "Error!",
                    "There was an error deleting the product.",
                    "error"
                  );
                }
              })
              .catch((error) => {
                console.error("Error:", error);
                Swal.fire(
                  "Error!",
                  "There was an error deleting the product.",
                  "error"
                );
              });
          }
        });
      }
    </script>
  </body>
</html>
