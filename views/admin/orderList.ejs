<link rel="stylesheet" href="/css/orderList.css" />
<%- include('../partials/adminSideNav') %>
<div class="outerMain">
  <h1 class="table-title">Order Details</h1>

  <table>
    <tr>
      <th>Order ID</th>
      <th>Order Status</th>
      <th>Payment Status</th>
      <th>Ordered At</th>
      <th>Total Amount</th>
    </tr>
    <% orderList.forEach(element => { %>
    <tr>
      <td><%= element.orderId %></td>
      <td>
        <select
          onchange="changeOrderStatus('<%=element._id%>')"
          name="orderStatus"
          id="orderStatus-<%= element._id %>"
        >
          <option value="<%= element.orderStatus %>" selected>
            <%= element.orderStatus %>
          </option>
          <% if (element.orderStatus !== 'Processing') { %>
            <option value="Processing">Processing</option>
            <% } %>
          <% if (element.orderStatus !== 'Shipped') { %>
          <option value="Shipped">Shipped</option>
          <% } %> <% if (element.orderStatus !== 'Delivered') { %>
          <option value="Delivered">Delivered</option>
          <% } %>
        </select>
      </td>
      <td><%= element.paymentStatus %></td>
      <td><%= element.orderedAt.toLocaleString() %></td>
      <td><%= element.totalAmount %></td>
    </tr>
    <% }) %>
  </table>
</div>
