<script>
  function changeOrderStatus(id) {
    const orderStatus = document.getElementById("orderStatus-"+id).value;
    fetch("/order/update-order-status", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ orderStatus: orderStatus, id: id }),
    })
     
  }
</script>
