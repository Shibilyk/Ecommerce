  <script>

document.getElementById('submition').addEventListener('click',(e)=>{
  
  const mainImage = document.getElementById("mainImage");
  const images = document.getElementById('images');
if(mainImage.files.length === 0 || images.files.length === 0){
  document.getElementById('photoError').classList.remove('hidden');
  e.preventDefault()
  }
 
})





/////////////////////////////////////////////////////////
        let slideIndex = 1;
        let slides = [];

        document.getElementById('images').addEventListener('change', function(event) {
            const files = event.target.files;
            const slideshowContainer = document.getElementById('slideshow-container');

            // Clear existing slides and reset the slides array
            slideshowContainer.innerHTML = '<button class="prev absolute top-1/2 left-0 transform -translate-y-1/2 bg-gray-700 text-white p-2 rounded-full hover:bg-gray-800 focus:outline-none" onclick="plusSlidesAndPreventDefault(event, -1)">&#10094;</button><button class="next absolute top-1/2 right-0 transform -translate-y-1/2 bg-gray-700 text-white p-2 rounded-full hover:bg-gray-800 focus:outline-none" onclick="plusSlidesAndPreventDefault(event, 1)">&#10095;</button>';
            slides = [];

            // Load new slides
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const reader = new FileReader();
                
                reader.onload = function(e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.classList.add('slides', 'w-full');
                    slideshowContainer.appendChild(img);
                    slides.push(img);
                    if (slides.length === 1) {
                        showSlides(slideIndex);
                    }
                };
                
                reader.readAsDataURL(file);
            }
        });

        function plusSlidesAndPreventDefault(event, n) {
            event.preventDefault();
            plusSlides(n);
        }

        function plusSlides(n) {
            showSlides(slideIndex += n);
        }

        function showSlides(n) {
            if (slides.length === 0) return;

            if (n > slides.length) { slideIndex = 1; }
            if (n < 1) { slideIndex = slides.length; }

            for (let i = 0; i < slides.length; i++) {
                slides[i].style.display = 'none';
            }
            slides[slideIndex - 1].style.display = 'block';
        }


//////////////////////////////////////////////////////////////


    const show_image = document.getElementById('imageDisplay');
    const fileInput = document.getElementById("mainImage");
    fileInput.onchange = ()=>{
      const file = fileInput.files[0];
        if (file) {
          show_image.style.display = 'block';
            show_image.src = URL.createObjectURL(file);
        }   
       };
 
    const fetchCategory = ()=>{
      const category = document.getElementById("category").value;
      fetch(`http://localhost:2001/getSubCategory/${category}`)
      .then(response=> {
    if (!response.ok) {
      throw new Error('Network response was not ok');
    }
    return response.json();
  })
  .then(data => {
    const subcategorySelect = document.getElementById("subcategory");
        subcategorySelect.innerHTML = '<option value="">Select a subcategory</option>';
        data.forEach(subCategory => {
            const option = document.createElement("option");
            option.value = subCategory._id; 
            option.textContent = subCategory.subCategory; 
            subcategorySelect.appendChild(option);  })
    })
  .catch(error => {
    console.error('There has been a problem with your fetch operation:', error);
  });
    }
  </script>
</body>
</html>
