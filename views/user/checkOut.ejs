<script>
  function submitForm(productId, size) {
    document.getElementById("quantityForm-" + productId + "-" + size).submit();
  }

  function incrementQuantity(productId, size) {
    const input = document.querySelector(`#quantityForm-${productId}-${size} input[name="quantity"]`);
    input.value = parseInt(input.value) + 1;
    submitForm(productId, size);
  }

  function decrementQuantity(productId, size) {
    const input = document.querySelector(`#quantityForm-${productId}-${size} input[name="quantity"]`);
    if (input.value > 1) {
      input.value = parseInt(input.value) - 1;
      submitForm(productId, size);
    }
  }
</script>
