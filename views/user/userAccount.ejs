<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Profile Card</title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
    <style>
      .bg-c-lite-green {
        background: linear-gradient(to right, #ee5a6f, #f29263);
      }
      .text-muted {
        color: #919aa3;
      }
      .img-radius {
        border-radius: 5px;
      }
    </style>
  </head>
  <body class="bg-gray-100">
    <div class="py-12">
      <div class="flex justify-center">
        <div class="w-full max-w-xl">
          <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="flex">
              <div
                class="w-1/3 bg-c-lite-green text-white flex flex-col items-center p-6"
              >
                <img
                  src="https://img.icons8.com/bubbles/100/000000/user.png"
                  class="img-radius mb-6"
                  alt="User-Profile-Image"
                />
                <!-- Logout button -->
                <a href="/user/logout"
                  class="mt-4 text-white bg-red-500 hover:bg-red-600 px-4 py-2 rounded"
                  >Logout</a
                >
              </div>
              <div class="w-2/3 p-6">
                <h6 class="text-lg font-semibold border-b pb-2 mb-6">
                  Information
                </h6>
                <form action="/user/myAccount" method="post" class="space-y-4">
                  <div>
                    <label class="block font-semibold mb-1" for="name"
                      >Name</label
                    >
                    <input
                      type="text"
                      id="name"
                      value="<%= user.name %>"
                      name="name"
                      class="w-full border border-gray-300 p-2 rounded"
                      required
                    />
                  </div>
                  <div>
                    <label class="block font-semibold mb-1" for="email"
                      >Email</label
                    >
                    <input
                      type="email"
                      id="email"
                      name="email"
                      value="<%= user.email %>"
                      class="w-full border border-gray-300 p-2 rounded"
                      required
                    />
                  </div>
  
                  <button
                    type="submit"
                    class="w-full bg-c-lite-green text-white p-2 rounded"
                  >
                    Update Information
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
  